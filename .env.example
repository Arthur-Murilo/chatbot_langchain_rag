# MongoDB Configuration
MONGO_USER=your_mongodb_username
MONGO_PASSWORD=your_mongodb_password
MONGO_HOST=your_mongodb_host
MONGO_PORT=your_mongodb_port
MONGO_DATABASE=your_database_name
MONGO_COLLECTION=your_collection_name

# Qdrant Configuration
QDRANT_URL=your_qdrant_url
QDRANT_COLLECTION=your_qdrant_collection_name

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Ollama Configuration
OLLAMA_MODEL=your_ollama_embedding_model
OLLAMA_BASE_URL=your_ollama_base_url

# LLM Configuration
LLM_MODEL=your_llm_model_name
LLM_TEMPERATURE=your_temperature_value
LLM_MAX_TOKENS=your_max_tokens_value
